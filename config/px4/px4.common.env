# Applied only when passed with --px4-env-file.
# Use PX4 parameter names, with the PX4_PARAM_ prefix.
PX4_PARAM_MAV_SYS_ID=10
PX4_PARAM_COM_OF_LOSS_T=15

# RC 5
PX4_PARAM_RC_MAP_FLTMODE=5
PX4_PARAM_RC_MAP_ARM_SW=6

#PX4_PARAM_COM_ARM_SWISBTN=0
#PX4_PARAM_COM_RC_ARM_HYST=1000  # Hold for 1 second

# Six flight-mode switch slots
#PX4_PARAM_COM_FLTMODE1=8   # Stabilized
#PX4_PARAM_COM_FLTMODE2=1   # Altitude
#PX4_PARAM_COM_FLTMODE3=2   # Position
#PX4_PARAM_COM_FLTMODE4=4   # Hold
#PX4_PARAM_COM_FLTMODE5=5   # Return
#PX4_PARAM_COM_FLTMODE6=7   # Offboard

#PX4_PARAM_COM_FLTMODE1=8   # Stabilized
#PX4_PARAM_COM_FLTMODE2=1   # Altitude
#PX4_PARAM_COM_FLTMODE3=2   # Position
#PX4_PARAM_COM_FLTMODE4=4   # Hold
#PX4_PARAM_COM_FLTMODE5=5   # Return
#PX4_PARAM_COM_FLTMODE6=7   # Offboard

PX4_PARAM_COM_FLTMODE1=7
PX4_PARAM_COM_FLTMODE2=7
PX4_PARAM_COM_FLTMODE3=2
PX4_PARAM_COM_FLTMODE4=2
PX4_PARAM_COM_FLTMODE5=8
PX4_PARAM_COM_FLTMODE6=8

# AUTOTUNE
#PX4_PARAM_MC_AT_EN=1       # Start the autotune module
#PX4_PARAM_MC_AT_APPLY=1    # Apply calculated gains after landing/disarming
#PX4_PARAM_MC_AT_START=0    # Wait for an explicit start request
# QGC → Analyze Tools → MAVLink Console: param set MC_AT_START 1
